# Copy this file to .env on your VPS, then fill in the values.
# Generate a unique secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
OWNER_EMAIL=your-email@example.com
AI_BASE_URL=https://openrouter.ai/api
AI_API_KEY=ADD_YOUR_PROVIDER_API_KEY_HERE
AI_MODEL=openrouter/free
DAILY_MESSAGE_LIMIT=50
